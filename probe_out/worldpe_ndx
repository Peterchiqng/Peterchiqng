function drawPrevForwardChart(scatterData, latest) {
  const chartOptions = {
    chart: {
      type: 'scatter',
      zoomType: 'xy',     // Zoom con drag su desktop
      panning: false,
    },
    title: {
      text: ''
    },
    xAxis: {
      title: {
        enabled: true,
        text: 'Previous Annualized Return (%)'
      },
      softMax: latest + 3,
      startOnTick: true,
      endOnTick: true,
      showLastLabel: true,
      plotLines: [{
        color: 'black',
        value: latest,
        width: 2,
        dashStyle: 'Dash',
        zIndex: 5,
        label: {
          text: 'Latest = '+ latest.toFixed(2),
          rotation: 0,
          align: 'left',
          verticalAlign: 'top',
          y: -2,
          x: -30,
          style: {
            color: 'black',
            fontSize: '10px',
            fontWeight: 'bold'
          }
        }
      }]
    },
    yAxis: {
      title: {
        text: 'Forward Annualized Return (%)'
      },
    },
    tooltip: {
      followTouchMove: false,
      formatter: function () {
        return (
          '<b>Trailing vs Forward ' + this.point.range + ' Return</b><br/>' +
          'Date: <b>' + this.point.name + '</b><br/>' +
          'Trailing Return: <b>' + this.x.toFixed(2) + '%</b><br/>' +
          'Forward Return: <b>' + this.y.toFixed(2) + '%</b>'
        );
      }
    },
    series: [{
      name: 'x',
      color: '#005b99',
      showInLegend: false,
      data: scatterData
    }]
  };

  const box = document.getElementById("prev-forw-chart");
  drawHighchart(box, chartOptions, false);
}
