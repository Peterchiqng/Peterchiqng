  <script type="text/javascript">
    function setPlotSerie(range) {
       document.getElementById('selectedRange').value = range;
       acToggleGeneric('ac-pe-history-full', 'avg-'+range);
       drawPlotSerie();
    }

    function setNormalizedSerie() {
       normalizedToggle = document.getElementById("detailPE-normalized");
       acToggleButton(normalizedToggle, 'pe-normalized', 'original', 'normalized');
       drawPlotSerie();
    }

    function drawPlotSerie() {
       range = document.getElementById('selectedRange').value;
       normalizedToggle = document.getElementById("detailPE-normalized");
       normalized = normalizedToggle.classList.contains("toggle-on");
       //console.log("normalized "+normalized);

       var obj = Highcharts.find(Highcharts.charts, function (chart) { return chart.renderTo.id === 'detailPeChart'; });

       if (obj.get('pe-base-serie')) {
         obj.get('pe-base-serie').remove();
       }
       if (obj.get('pe-normalized-serie')) {
         obj.get('pe-normalized-serie').remove();
       }
       if (obj.get('avg-serie')) {
         obj.get('avg-serie').remove();
       }
       if (obj.get('range-serie')) {
         obj.get('range-serie').remove();
       }
       if (obj.get('range2-serie')) {
         obj.get('range2-serie').remove();
       }

       if (!normalized || (range == 0)) {
         obj.addSeries({
             id: 'pe-base-serie',
             name: 'P/E ratio',
             color: '#005b99',
             animation: false,
             data: detailPE_data,
         });
       }
       if (range > 0) {
         if (normalized) {
           obj.addSeries({
               id: 'pe-normalized-serie',
               name: 'P/E normalized vs (&mu; , &sigma;)',
               color: '#005b99',
               animation: false,
               data: detailPE_data_pe_normalized[range],
           });
           obj.yAxis[0].update({
               labels: {
                 formatter: function () {
                    if (this.value == 0) {
                      return '&mu;';
                    }
                    return this.value + '&sigma;';
                 }
               }
           });
         } else {
           obj.addSeries({
               id: 'avg-serie',
               name: 'Rolling '+(range/12)+'Y • Average',
               color: 'black',
               animation: false,
               lineWidth: 2,
               marker: false,
               data: detailPE_data_avg[range],
           });
           obj.addSeries({
               id: 'range-serie',
               name: '1 Std Dev range',
               type: 'arearange',
               lineWidth: 0,
               color: 'gray',
               animation: false,
               fillOpacity: 0.3,
               zIndex: 1,
               marker: false,
               data: detailPE_data_range[range],
           });
           obj.addSeries({
               id: 'range2-serie',
               name: '2 Std Dev range',
               type: 'arearange',
               lineWidth: 0,
               color: 'gray',
               animation: false,
               fillOpacity: 0.2,
               zIndex: 0,
               marker: false,
               data: detailPE_data_2_range[range],
           });
           obj.yAxis[0].update({
               labels: {
                 formatter: function () {
                    return this.value;
                 }
               }
           });
         }

       }
    }
</script>

